<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>CSharpExtensions.AspNetCore</AssemblyName>
    <RootNamespace>CSharpExtensions.AspNetCore</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpExtensions.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup Condition="'$(UsePublishedToolsDependencies)' == 'true'">
    <PackageReference Include="CSharpExtensions.Foundation" VersionOverride="[$(ToolsPackageVersion)]" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePublishedToolsDependencies)' != 'true'">
    <ProjectReference Include="..\CSharpExtensions.Foundation\CSharpExtensions.Foundation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <None Include="build\CSharpExtensions.AspNetCore.props" Pack="true" PackagePath="build" Condition="Exists('build\CSharpExtensions.AspNetCore.props')" />
  </ItemGroup>

  <Target Name="ValidatePublishedToolsDependencies"
          BeforeTargets="Restore;Build;Pack"
          Condition="'$(UsePublishedToolsDependencies)' == 'true'">
    <Error Condition="'$(ToolsPackageVersion)' == ''"
           Text="ToolsPackageVersion must be an exact full package version in published-dependency mode." />
  </Target>

</Project>
