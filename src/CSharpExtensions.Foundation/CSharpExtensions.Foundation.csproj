<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>CSharpExtensions.Foundation</AssemblyName>
    <RootNamespace>CSharpExtensions.Foundation</RootNamespace>
    <!-- Configure NuGet to include the analyzer assembly -->
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);_AddAnalyzerToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>CSharpExtensions.Tests</_Parameter1>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>DynamicProxyGenAssembly2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="libphonenumber-csharp" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Sqids" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePublishedToolsDependencies)' != 'true'">
    <!-- Reference the generator project locally as an Analyzer -->
    <ProjectReference Include="..\CSharpExtensions.Security.Generators\CSharpExtensions.Security.Generators.csproj" 
                      PrivateAssets="all" 
                      ReferenceOutputAssembly="false" 
                      OutputItemType="Analyzer" />
  </ItemGroup>

  <ItemGroup Condition="'$(UsePublishedToolsDependencies)' == 'true'">
    <Analyzer Include="..\CSharpExtensions.Security.Generators\bin\$(Configuration)\netstandard2.0\CSharpExtensions.Security.Generators.dll" />
  </ItemGroup>

  <Target Name="_AddAnalyzerToPackage">
    <PropertyGroup>
      <_PiiMaskingGeneratorPath>$(MSBuildThisFileDirectory)..\CSharpExtensions.Security.Generators\bin\$(Configuration)\netstandard2.0\CSharpExtensions.Security.Generators.dll</_PiiMaskingGeneratorPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(_PiiMaskingGeneratorPath)')"
           Text="The PII masking generator must be built before packing CSharpExtensions.Foundation." />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(_PiiMaskingGeneratorPath)"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <Target Name="ValidatePublishedToolsDependencies"
          BeforeTargets="Restore;Build;Pack"
          Condition="'$(UsePublishedToolsDependencies)' == 'true'">
    <Error Condition="'$(ToolsPackageVersion)' == ''"
           Text="ToolsPackageVersion must be an exact full package version in published-dependency mode." />
  </Target>

</Project>
