<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CSharpExtensionsVersion>1.0.0</CSharpExtensionsVersion>
    <Version>$(CSharpExtensionsVersion)</Version>
    <PackageVersion>$(CSharpExtensionsVersion)</PackageVersion>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>$(CSharpExtensionsVersion).0</FileVersion>
    <Authors>Sergey Sorokin</Authors>
    <Company>Sergey Sorokin</Company>
    <Copyright>Copyright © 2026 Sergey Sorokin</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>csharp;dotnet;extensions;railway-oriented-programming;kafka;aspnetcore;security;pii-masking</PackageTags>
    <PackageReleaseNotes>1.0.0: consolidated ecosystem into 3 core packages (Core, AspNetCore, Kafka) with native ROP and security hardening.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/backend-crafter/CSharpExtensions.git</RepositoryUrl>
    <PackageProjectUrl>https://github.com/backend-crafter/CSharpExtensions</PackageProjectUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(ContinuousIntegrationBuild)' == 'true'">true</RestoreLockedMode>
    <PackageOutputPath>$(MSBuildThisFileDirectory)artifacts</PackageOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS1591;NU1510</NoWarn>
    <ApiCompatEnableRuleCannotChangeParameterName>true</ApiCompatEnableRuleCannotChangeParameterName>
  </PropertyGroup>

  <!-- Use only for an explicitly acknowledged dirty local build; clean CI keeps full source provenance. -->
  <PropertyGroup Condition="'$(CSharpExtensionsDirtyWorkingTreeBuild)' == 'true'">
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <EnableSourceLink>false</EnableSourceLink>
    <EmbedUntrackedSources>false</EmbedUntrackedSources>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SourceRevisionId />
    <RepositoryCommit />
  </PropertyGroup>

  <PropertyGroup>
    <Description Condition="'$(MSBuildProjectName)' == 'CSharpExtensions.Core'">Core foundation library for CSharpExtensions services: Railway Oriented Programming (ROP), JSON serialization, POCO exceptions, crypto/security, PII masking, phone normalization, and infrastructure helpers.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'CSharpExtensions.AspNetCore'">ASP.NET Core integration for CSharpExtensions services: Authentication (JWT &amp; S2S), Actor Context, CORS, Swagger documentation, ProblemDetails, and ROP action results.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'CSharpExtensions.Kafka'">Enterprise Kafka messaging, transactional outbox, deduplication, S3 claim check, and operational diagnostics for CSharpExtensions services.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'CSharpExtensions.Kafka.Cli'">Command-line tool for generating schema upcasters for CSharpExtensions Kafka events.</Description>
    <Description Condition="'$(MSBuildProjectName)' == 'CSharpExtensions.Security.Generators'">Roslyn Source Generator for compile-time high-performance PII data masking.</Description>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)README.md')">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>

</Project>
